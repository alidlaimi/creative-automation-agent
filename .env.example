# Kopie als .env anlegen und lokal ausfüllen. .env wird nie committet.

# Anthropic API
ANTHROPIC_API_KEY=
# Modell-ID aus der offiziellen Modellübersicht eintragen (docs.claude.com)
ANTHROPIC_MODEL=

# Galaxus MCP – offizielle Adresse, Quelle: docs/quellen/galaxus-mcp.md
GALAXUS_MCP_URL=https://mcp.galaxus.ch

# Budgets pro Lauf
RUN_BUDGET_USD=0.50
RUN_TIMEOUT_SECONDS=180

# Cache für MCP-Antworten (Sekunden)
MCP_CACHE_TTL_SECONDS=86400

LOG_LEVEL=INFO
