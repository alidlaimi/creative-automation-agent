# Kopie als .env anlegen und lokal ausfüllen. .env wird nie committet.

# Anthropic API
ANTHROPIC_API_KEY=
# Modell-IDs: https://platform.claude.com/docs/en/models/overview (geprüft 2026-11-20)
# Nur Modelle mit hinterlegtem Preis (src/creative_agent/workflow/budget.py) sind erlaubt.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5

# Galaxus MCP – offizielle Adresse, Quelle: docs/quellen/galaxus-mcp.md
GALAXUS_MCP_URL=https://mcp.galaxus.ch

# Budgets pro Lauf
RUN_BUDGET_USD=0.50
RUN_TIMEOUT_SECONDS=180

# Cache für MCP-Antworten (Sekunden)
MCP_CACHE_TTL_SECONDS=86400

LOG_LEVEL=INFO
